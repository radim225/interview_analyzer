# Azure AI Language / Cognitive Services
# Create a Language (or Cognitive Services) resource in Azure Portal,
# then copy Key and Endpoint from the resource's Keys and Endpoint page.
#
# Use either AZURE_COGNITIVE_KEY or AZURE_LANGUAGE_KEY (first one set wins).
AZURE_COGNITIVE_KEY=your-azure-resource-key-here
# AZURE_LANGUAGE_KEY=your-azure-resource-key-here

AZURE_COGNITIVE_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com/
